{
  "manifest_version": 3,
  "name": "Withcomy Extension",
  "version": "1.0.0",
  "description": "Withcomy browser extension prototype.",
  "permissions": ["storage"],
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}